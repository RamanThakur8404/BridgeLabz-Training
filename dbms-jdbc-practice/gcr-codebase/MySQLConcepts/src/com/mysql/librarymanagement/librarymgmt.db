-- mysql>
 CREATE TABLE book(book_id INT PRIMARY KEY AUTO_INCREMENT,
      title VARCHAR(90) NOT NULL,
      author VARCHAR(50),
      category VARCHAR(50),
      total_copies INT,
      available_copies INT
      );

/* o/p
Query OK, 0 rows affected (0.02 sec)
*/

