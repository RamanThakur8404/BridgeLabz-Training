=================================================================================
		Fine Calculation for Late Return (After 7 Days) :
=================================================================================

-- mysql> 
SELECT borrow_id, student_id, book_id,
    -> DATEDIFF(CURDATE(), borrow_date)-7 AS late_days,
    -> (DATEDIFF(CURDATE(), borrow_date)-7)*5 AS fine_amount
    -> FROM borrow_records
    -> WHERE return_date IS NULL
    -> AND DATEDIFF(CURDATE(), borrow_date) > 7;

/*o/p
+-----------+------------+---------+-----------+-------------+
| borrow_id | student_id | book_id | late_days | fine_amount |
+-----------+------------+---------+-----------+-------------+
|         3 |          3 |       2 |         2 |          10 |
+-----------+------------+---------+-----------+-------------+
1 row in set (0.01 sec)
*/ 


=================================================================================
		Search Book by Author and Category :
=================================================================================
   
-- mysql> 
SELECT * FROM book WHERE author = 'John Smith' AND category = 'Education';

/* o/p
+---------+-------------+------------+-----------+--------------+------------------+
| book_id | title       | author     | category  | total_copies | available_copies |
+---------+-------------+------------+-----------+--------------+------------------+
|       1 | Math Basics | John Smith | Education |           10 |               10 |
+---------+-------------+------------+-----------+--------------+------------------+
1 row in set (0.01 sec)   
*/

=================================================================================
		Search Available Books :
=================================================================================
   
-- mysql> 
SELECT * FROM book WHERE available_copies > 0;

/* o/p
+---------+-----------------+--------------+------------+--------------+------------------+
| book_id | title           | author       | category   | total_copies | available_copies |
+---------+-----------------+--------------+------------+--------------+------------------+
|       1 | Math Basics     | John Smith   | Education  |           10 |               10 |
|       2 | Science Guide   | David Lee    | Education  |            8 |                8 |
|       3 | English Grammar | Mary John    | Language   |           12 |               12 |
|       4 | History Notes   | Ravi Kumar   | History    |            6 |                6 |
|       5 | Computer Basics | Anita Sharma | Technology |            9 |                9 |
+---------+-----------------+--------------+------------+--------------+------------------+
5 rows in set (0.00 sec)
*/

=================================================================================
							Search Book by Title :
=================================================================================
   
-- mysql> 
SELECT * FROM book WHERE title LIKE '%G%';

/* o/p
+---------+-----------------+-----------+-----------+--------------+------------------+
